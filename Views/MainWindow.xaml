<Window x:Class="MabinogiCraftOptimizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MabinogiCraftOptimizer.ViewModels"
        mc:Ignorable="d"
        Title="LOREWAY TOOLKIT" 
        Height="780" Width="1120"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic"
        FontSize="13"
        Background="#08111C">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. 헤더 타이틀 및 주요 액션 버튼 -->
            <RowDefinition Height="Auto"/> <!-- 1. 제작 설정 카드 (완제품 선택 및 구슬 시세) -->
            <RowDefinition Height="Auto"/> <!-- 2. 3대 핵심 요약 카드 및 구슬 배너 -->
            <RowDefinition Height="*"/>    <!-- 3. 메인 탭 컨텐츠: [제작 트리] 및 [필요 재료] -->
            <RowDefinition Height="Auto"/> <!-- 4. 하단 상태 바 -->
        </Grid.RowDefinitions>

        <!-- ==================== 0. 헤더 영역 ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 타이틀 및 간결한 서브타이틀 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#12372F" BorderBrush="#2A8F70" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="v1.0" FontSize="11" FontWeight="Bold" Foreground="#2DAE82" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="LOREWAY TOOLKIT" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="#F7F7F2"/>
                </StackPanel>
                <TextBlock Text="마비노기 유틸리티 도구" 
                           FontSize="13" 
                           Foreground="#B7C2CE" 
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 주요 액션 버튼 그룹 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 시세 갱신 (Breigh Green) -->
                <Button Content="시세 갱신" 
                        Style="{StaticResource PrimaryButton}"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="OnRefreshNormalPricesClick"
                        IsEnabled="{Binding IsNotLoading}"
                        ToolTip="10분 이내 캐시가 있으면 재사용하고, 만료/신규 아이템만 API로 조회합니다."/>

                <!-- 강제 갱신 (Breigh Orange) -->
                <Button Content="강제 갱신" 
                        Style="{StaticResource WarningButton}"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="OnRefreshForcePricesClick"
                        IsEnabled="{Binding IsNotLoading}"
                        ToolTip="캐시를 무시하고 시세를 다시 조회합니다."/>

                <!-- 레시피 추가 (Breigh Green - 특수문자 없음) -->
                <Button Content="레시피 추가" 
                        Style="{StaticResource SuccessButton}"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="OnAddRecipeClick"
                        ToolTip="새로운 무기 또는 제작재료 레시피를 등록합니다."/>

                <!-- 수정 / 저장 (Gold / Green 동적 바인딩) -->
                <Button Content="{Binding EditButtonText}" 
                        Padding="14,6"
                        Height="34"
                        FontWeight="Bold"
                        FontSize="13"
                        Background="{Binding OrbEditButtonBackground}" 
                        Foreground="#F7F7F2"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnToggleOrbEditClick"
                        ToolTip="보유 수량, 시세 단가, 구슬 개수 등을 직접 수정하거나 저장합니다.">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 1. 제작 설정 카드 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource DarkCardStyle}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- 1. 제작 대상 (무기 / 제작재료 그룹) -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="제작 대상" FontWeight="SemiBold" FontSize="12" Foreground="#B7C2CE" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding RecipeView}"
                              SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                              DisplayMemberPath="ItemName"
                              Height="36"
                              Background="#122033"
                              Foreground="#F7F7F2"
                              BorderBrush="#263A4F"
                              BorderThickness="1"
                              FontSize="13"
                              VerticalContentAlignment="Center"
                              Padding="12,0,32,0">
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D1928" BorderBrush="#263A4F" BorderThickness="0,0,0,1" Padding="8,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#D9B63C"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                </StackPanel>

                <!-- 2. 구슬 1개 환산가 -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="구슬 1개 환산가" FontWeight="SemiBold" FontSize="12" Foreground="#D9B63C" Margin="0,0,0,6"/>
                    <Border Background="#122033" BorderBrush="#887121" BorderThickness="1" CornerRadius="6" Height="36">
                        <Grid VerticalAlignment="Center" Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                     Text="{Binding OrbPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#EAC84E"
                                     CaretBrush="#D9B63C"
                                     FontSize="15"
                                     FontWeight="Bold"
                                     HorizontalContentAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     ToolTip="구슬 1개를 Gold 기준으로 환산한 값입니다."/>
                            <TextBlock Grid.Column="1" Text=" G" VerticalAlignment="Center" Foreground="#D9B63C" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. 3대 핵심 요약 카드 및 구슬 배너 ==================== -->
        <Border Grid.Row="2" Style="{StaticResource DarkCardStyle}" Margin="0,0,0,12" Padding="14,12">
            <StackPanel>
                <!-- 3개 균등 분할 핵심 카드 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 카드 1: 완제품 경매장가 -->
                    <Border Grid.Column="0" Background="#17273A" BorderBrush="#263A4F" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="완제품 경매장가" FontSize="12" FontWeight="SemiBold" Foreground="#B7C2CE" Margin="0,0,0,4"/>
                            <Grid VerticalAlignment="Center" Height="30">
                                <!-- 조회 모드 -->
                                <TextBlock Text="{Binding FinishedItemPriceText}" 
                                           FontSize="17" 
                                           FontWeight="Bold" 
                                           Foreground="#F7F7F2" 
                                           VerticalAlignment="Center"
                                           Visibility="{Binding EditViewVisibility}"/>
                                <!-- 수정 모드 -->
                                <StackPanel Orientation="Horizontal" Visibility="{Binding EditInputVisibility}" VerticalAlignment="Center">
                                    <TextBox Text="{Binding FinishedItemAuctionPriceInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}"
                                             Width="130"
                                             Height="28"
                                             FontSize="13"
                                             FontWeight="Bold"
                                             HorizontalContentAlignment="Right"
                                             Margin="0,0,6,0"/>
                                    <TextBlock Text="G" FontSize="13" FontWeight="Bold" Foreground="#B7C2CE" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 카드 2: 최적 제작 비용 (Breigh Green Soft Card) -->
                    <Border Grid.Column="1" Background="#12372F" BorderBrush="#2A8F70" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="최적 제작 비용" FontSize="12" FontWeight="SemiBold" Foreground="#2DAE82" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding OptimizedCostText}" 
                                       FontSize="19" 
                                       FontWeight="Bold" 
                                       Foreground="#2DAE82" 
                                       VerticalAlignment="Center"
                                       Height="30"/>
                        </StackPanel>
                    </Border>

                    <!-- 카드 3: 최종 추천 (Breigh Green Dark Card) -->
                    <Border Grid.Column="2" Background="#13604B" BorderBrush="#239A72" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="최종 추천" FontSize="12" FontWeight="SemiBold" Foreground="#F7F7F2" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding BuyVsCraftDecisionText}" 
                                       FontSize="17" 
                                       FontWeight="Bold" 
                                       Foreground="#FFFFFF" 
                                       VerticalAlignment="Center"
                                       Height="30"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 하단 구슬 요약 배지 (내용물 크기에 딱 맞게 자동 조절) -->
                <Border HorizontalAlignment="Left"
                        Background="#342D16" 
                        BorderBrush="#887121" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="8,5" 
                        Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#D9B63C" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="구슬 필요량" FontSize="11" FontWeight="Bold" Foreground="#08111C"/>
                        </Border>
                        <TextBlock Text="{Binding TotalRequiredOrbsText}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ==================== 3. 탭 컨트롤 (제작 트리 / 필요 재료) ==================== -->
        <TabControl Grid.Row="3" 
                    Style="{StaticResource DarkTabControl}" 
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- 탭 1: 제작 트리 -->
            <TabItem Header="제작 트리">
                <Border Background="#17273A" BorderBrush="#263A4F" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Padding="10">
                    <TreeView ItemsSource="{Binding CraftTreeNodes}" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}">
                        <TreeView.Resources>
                            <!-- 기본 선택 하이라이트 브러시 무효화 -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F7F7F2"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F7F7F2"/>

                            <!-- 트리뷰 확장/축소 토글 버튼 스타일 -->
                            <Style x:Key="TreeExpanderToggleStyle" TargetType="{x:Type ToggleButton}">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Width" Value="16"/>
                                <Setter Property="Height" Value="16"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path x:Name="Arrow" 
                                                      Data="M 3 2 L 8 7 L 3 12 Z" 
                                                      Fill="#6E8294" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Data" Value="M 2 4 L 12 4 L 7 9 Z"/>
                                                    <Setter TargetName="Arrow" Property="Fill" Value="#B7C2CE"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="19"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <ToggleButton x:Name="Expander" 
                                                              Style="{StaticResource TreeExpanderToggleStyle}" 
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" 
                                                              ClickMode="Press" 
                                                              VerticalAlignment="Center"/>
                                                <Border x:Name="Bd" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0">
                                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Left"/>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="false">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="false">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:CraftTreeNodeViewModel}" ItemsSource="{Binding Children}">
                                <Border Margin="2,2" Padding="8,6" Background="#122033" BorderBrush="#263A4F" BorderThickness="1" CornerRadius="6"
                                        Width="{Binding NodeWidth}" HorizontalAlignment="Left">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. 좌측 정렬: 아이템명 (White) + 최상위 완제품일 때 '제작 목표' 배지 -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemName}" FontWeight="Bold" FontSize="14" Foreground="#F7F7F2" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                                            <Border Visibility="{Binding RootBadgeVisibility}" Background="#12372F" BorderBrush="#2A8F70" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="제작 목표" FontSize="12" FontWeight="Bold" Foreground="#2DAE82"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- 2. 우측 정렬: 필요 / 보유 / 부족 / 방법 / 가격 (하위 재료들만 표시) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="{Binding DetailVisibility}">
                                            <!-- 필요 (일정한 크기: 폭 85px 통일) -->
                                            <Border Width="85" Background="#17273A" BorderBrush="#263A4F" BorderThickness="1" CornerRadius="4" Padding="0,3" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RequiredQuantity, StringFormat={}필요 {0}개}" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#B7C2CE"/>
                                            </Border>

                                            <!-- 보유 (일정한 크기: 폭 85px 통일 / 조회: 배지, 수정: TextBox) -->
                                            <Grid Width="85" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <!-- 조회 모드 -->
                                                <Border Background="#17273A" BorderBrush="#263A4F" BorderThickness="1" CornerRadius="4" Padding="0,3" Visibility="{Binding EditViewVisibility}">
                                                    <TextBlock Text="{Binding OwnedQuantityDisplay, StringFormat={}보유 {0}}" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#B7C2CE"/>
                                                </Border>
                                                <!-- 수정 모드 -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding EditInputVisibility}">
                                                    <TextBlock Text="보유" FontSize="11" Foreground="#B7C2CE" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBox Text="{Binding OwnedQuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                             Style="{StaticResource DarkTextBox}"
                                                             Width="48" 
                                                             Height="24" 
                                                             HorizontalContentAlignment="Right" 
                                                             FontSize="12"
                                                             FontWeight="SemiBold"
                                                             Padding="2,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 부족 (일정한 크기: 폭 85px 통일, Breigh Orange) -->
                                            <Border Width="85" Background="#3A2417" BorderBrush="#8B4317" BorderThickness="1" CornerRadius="4" Padding="0,3" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MissingQuantity, StringFormat={}부족 {0}개}" TextAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#E77E28"/>
                                            </Border>

                                            <!-- 최적 방법 (일정한 크기: 폭 85px 통일, Breigh Green 배지) -->
                                            <Border Width="85" Background="#12372F" BorderBrush="#2A8F70" BorderThickness="1" CornerRadius="4" Padding="0,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MethodDisplayText}" TextAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#2DAE82"/>
                                            </Border>

                                            <!-- 총 비용 (우측 정렬 115px 골드/연노랑 볼드) -->
                                            <TextBlock Text="{Binding CostDisplayText}" TextAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#D9B63C" VerticalAlignment="Center" Width="115"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>
            </TabItem>

            <!-- 탭 2: 필요 재료 -->
            <TabItem Header="필요 재료">
                <Border Background="#17273A" BorderBrush="#263A4F" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
                    <DataGrid ItemsSource="{Binding LeafMaterials}" 
                              SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                              Style="{StaticResource DarkDataGrid}"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <!-- 1. 재료 이름 (상단바: 중앙 정렬, 내용: 좌측 정렬, White) -->
                            <DataGridTextColumn Header="재료 이름" 
                                                Binding="{Binding Name}" 
                                                IsReadOnly="True" 
                                                Width="160">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#F7F7F2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 2. 필요 (숫자: 우측 정렬, Secondary) -->
                            <DataGridTextColumn Header="필요" 
                                                Binding="{Binding RequiredQuantityDisplay}" 
                                                IsReadOnly="True" 
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,12,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#B7C2CE"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 3. 보유 (숫자: 우측 정렬, 조회 시 TextBlock / 수정 시 TextBox) -->
                            <DataGridTemplateColumn Header="보유" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                            <!-- 조회 모드 -->
                                            <TextBlock Text="{Binding OwnedQuantityDisplay}" 
                                                       TextAlignment="Right" 
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#B7C2CE"
                                                       Margin="0,0,6,0"
                                                       Visibility="{Binding EditViewVisibility}"/>
                                            <!-- 수정 모드 -->
                                            <TextBox Text="{Binding OwnedQuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DarkTextBox}"
                                                     HorizontalContentAlignment="Right"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     Padding="4,1"
                                                     Visibility="{Binding EditInputVisibility}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 4. 부족 (숫자: 우측 정렬, Breigh Orange 강조) -->
                            <DataGridTextColumn Header="부족" 
                                                Binding="{Binding MissingQuantityDisplay}" 
                                                IsReadOnly="True" 
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,12,0"/>
                                        <Setter Property="Foreground" Value="#E77E28"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 5. 경매장 단가 (숫자: 우측 정렬, White) -->
                            <DataGridTemplateColumn Header="경매장 단가" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                            <!-- 조회 모드 -->
                                            <TextBlock Text="{Binding AuctionUnitPriceText}" 
                                                       TextAlignment="Right" 
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F7F7F2"
                                                       Margin="0,0,6,0"
                                                       Visibility="{Binding EditViewVisibility}"/>
                                            <!-- 수정 모드 -->
                                            <TextBox Text="{Binding AuctionUnitPriceInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DarkTextBox}"
                                                     IsEnabled="{Binding CanEditAuctionPrice}"
                                                     HorizontalContentAlignment="Right"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     Padding="4,1"
                                                     Visibility="{Binding EditInputVisibility}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 6. 구슬 (개당) (숫자: 우측 정렬, Breigh Gold 테마) -->
                            <DataGridTemplateColumn Header="구슬 (개당)" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                                            <!-- 1. 조회 모드: 구슬 개수 및 아래 환산 가격 표시 -->
                                            <StackPanel Visibility="{Binding EditViewVisibility}" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding OrbUnitText}" 
                                                           FontSize="12" 
                                                           FontWeight="Bold" 
                                                           Foreground="#EAC84E" 
                                                           TextAlignment="Right"/>
                                                <TextBlock Text="{Binding OrbGoldEquivalentText}" 
                                                           FontSize="10" 
                                                           Foreground="#D9B63C" 
                                                           TextAlignment="Right" 
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- 2. 수정 모드: 텍스트 박스로 전환 -->
                                            <Grid Visibility="{Binding EditInputVisibility}" HorizontalAlignment="Right">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding OrbQuantityInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{StaticResource DarkTextBox}"
                                                         Width="55"
                                                         FontSize="12" 
                                                         FontWeight="Bold" 
                                                         HorizontalContentAlignment="Right" 
                                                         VerticalContentAlignment="Center"
                                                         Padding="3,1"
                                                         Margin="0,0,4,0"/>
                                                <TextBlock Grid.Column="1" Text="개" FontSize="11" Foreground="#B7C2CE" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 7. 기타 획득처 (글자: 좌측 정렬) -->
                            <DataGridTextColumn Header="기타 획득처" 
                                                Binding="{Binding OtherMethodsText}" 
                                                IsReadOnly="True" 
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B7C2CE"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0,0,0"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 8. 최적 추천 (방법 + 부족수량 총비용, Breigh Green) -->
                            <DataGridTextColumn Header="최적 추천" 
                                                Binding="{Binding RecommendedMethodWithCostText}" 
                                                IsReadOnly="True" 
                                                Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#2DAE82"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ==================== 4. 하단 상태 바 ==================== -->
        <StatusBar Grid.Row="4" Background="#0D1928" BorderBrush="#263A4F" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="8,4">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Text="{Binding ApiStatusMessage}" FontSize="12" Foreground="#B7C2CE"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding LastRefreshedTimeText}" FontSize="12" FontWeight="SemiBold" Foreground="#8391A1"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
